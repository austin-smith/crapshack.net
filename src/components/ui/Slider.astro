---
import type { HTMLAttributes } from 'astro/types';

/** Single-value native slider. Label with aria-label, aria-labelledby, or a label element. */
type Props = Omit<HTMLAttributes<'input'>, 'type'>;

const { min = 0, max = 100, step = 1, class: className, ...attributes } = Astro.props;
---

<input {...attributes} type="range" min={min} max={max} step={step} class:list={['ui-slider', className]} />

<style>
	@layer components {
		.ui-slider {
			min-width: 0;
			width: 100%;
			height: 1.1rem;
			margin: 0;
			accent-color: var(--ui-control-color, var(--app-brand));
			cursor: ew-resize;
		}

		.ui-slider:focus-visible {
			outline: 2px solid var(--ui-control-focus, var(--app-brand));
			outline-offset: 3px;
		}

		.ui-slider:disabled {
			cursor: default;
			opacity: 0.35;
		}
	}
</style>
