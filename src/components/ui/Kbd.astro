---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'kbd'>;

const { class: className, ...attributes } = Astro.props;
---

<kbd {...attributes} class:list={['ui-kbd', className]} data-slot="kbd"><slot /></kbd>

<style>
	@layer components {
		.ui-kbd {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.25rem;
			width: fit-content;
			min-width: 1.25rem;
			height: 1.25rem;
			padding-inline: 0.25rem;
			border-radius: 0.25rem;
			background: var(--app-fill);
			color: var(--ui-control-muted, var(--app-dim));
			font-family: var(--font-sans);
			font-size: 0.75rem;
			font-weight: 500;
			line-height: 1rem;
			white-space: nowrap;
			pointer-events: none;
			user-select: none;
		}

		.ui-kbd :global(svg:not([class*='size-'])) {
			width: 0.75rem;
			height: 0.75rem;
		}
	}
</style>
