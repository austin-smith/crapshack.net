---
import type { HTMLAttributes } from 'astro/types';
import { buttonVariants, type ButtonStyleOptions } from './button';

interface Props extends HTMLAttributes<'button'>, ButtonStyleOptions {}

const { variant = 'default', size = 'md', type = 'button', class: className, ...attributes } = Astro.props;
---

<button {...attributes} type={type} class:list={[buttonVariants({ variant, size }), className]} data-variant={variant} data-size={size}>
	<slot />
</button>
