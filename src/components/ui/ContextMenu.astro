---
import { ChevronRight, Circle } from '@lucide/astro';
import ContextMenuEntry, {
	type ContextMenuActionItem,
	type ContextMenuEntryItem,
	type ContextMenuItemBase,
} from './ContextMenuEntry.astro';

interface ContextMenuRadioGroup {
	name: string;
	value: string;
	items: ContextMenuActionItem[];
}

interface ContextMenuRadioSubItem extends ContextMenuItemBase {
	radioGroup: ContextMenuRadioGroup;
}

interface ContextMenuListSubItem extends ContextMenuItemBase {
	items: ContextMenuEntryItem[];
}

type ContextMenuSubItem = ContextMenuRadioSubItem | ContextMenuListSubItem;

interface ContextMenuGroup {
	label?: string;
	items: (ContextMenuEntryItem | ContextMenuSubItem)[];
}

interface Props {
	id: string;
	/** Accessible name for the menu content. */
	ariaLabel: string;
	heading?: string;
	groups: ContextMenuGroup[];
	class?: string;
}

const { id, ariaLabel, heading, groups, class: className } = Astro.props;

const isSubItem = (item: ContextMenuEntryItem | ContextMenuSubItem): item is ContextMenuSubItem => (
	'radioGroup' in item || 'items' in item
);
---

<div
	class={`context-menu-root ${className ?? ''}`}
	data-context-menu-root
>
	<div class="context-menu-trigger" data-context-menu-trigger>
		<slot name="trigger" />
	</div>

	<div
		id={id}
		class="context-menu-content"
		role="menu"
		tabindex="-1"
		aria-label={ariaLabel}
		data-context-menu-content
		hidden
	>
		{heading && <div class="context-menu-heading">{heading}</div>}
		{groups.map((group, index) => (
			<>
				{index > 0 && <div class="context-menu-separator" role="separator"></div>}
				<div class="context-menu-group" role="group">
					{group.label && <div class="context-menu-label">{group.label}</div>}
					{group.items.map((item, itemIndex) => {
						if (!isSubItem(item)) return <ContextMenuEntry item={item} />;

						const ItemIcon = typeof item.icon === 'string' ? undefined : item.icon;
						const iconText = typeof item.icon === 'string' ? item.icon : undefined;
						const submenuId = `${id}-submenu-${index}-${itemIndex}`;
						const selectedRadioItem = 'radioGroup' in item
							? item.radioGroup.items.find((radioItem) => radioItem.value === item.radioGroup.value)
							: undefined;
						return (
							<div class="context-menu-sub">
								<button
									type="button"
									class="context-menu-item"
									role="menuitem"
									tabindex="-1"
									disabled={item.disabled}
									aria-disabled={item.disabled ? 'true' : undefined}
									aria-haspopup="menu"
									aria-expanded="false"
									aria-controls={submenuId}
									aria-label={selectedRadioItem ? `${item.label}, ${selectedRadioItem.label}` : undefined}
									data-context-menu-item
									data-context-menu-sub-label={item.label}
									data-context-menu-sub-trigger
								>
									{item.icon && (
										<span class="context-menu-item-leading" aria-hidden="true">
											{ItemIcon ? <ItemIcon /> : iconText}
										</span>
									)}
									<span data-context-menu-sub-value>{selectedRadioItem?.label ?? item.label}</span>
									<ChevronRight class="context-menu-sub-chevron" aria-hidden="true" />
								</button>
								<div
									id={submenuId}
									class="context-menu-sub-content"
									role="menu"
									tabindex="-1"
									aria-label={item.label}
									data-context-menu-sub-content
									hidden
								>
									{'radioGroup' in item ? (
										<div
											role="group"
											data-context-menu-radio-group={item.radioGroup.name}
											data-context-menu-value={item.radioGroup.value}
										>
											<div class="context-menu-label">{item.label}</div>
											{item.radioGroup.items.map((radioItem) => (
												<button
													type="button"
													class="context-menu-item context-menu-radio-item"
													role="menuitemradio"
													tabindex="-1"
													disabled={radioItem.disabled}
													aria-disabled={radioItem.disabled ? 'true' : undefined}
													aria-checked={radioItem.value === item.radioGroup.value}
													data-context-menu-item
													data-context-menu-value={radioItem.value}
												>
													<span class="context-menu-radio-indicator" aria-hidden="true">
														<Circle />
													</span>
													{radioItem.label}
												</button>
											))}
										</div>
									) : (
										<div class="context-menu-group" role="group">
											<div class="context-menu-label">{item.label}</div>
											{item.items.map((subItem) => <ContextMenuEntry item={subItem} />)}
										</div>
									)}
								</div>
							</div>
						);
					})}
				</div>
			</>
		))}
	</div>
</div>

<script>
	import { initContextMenus } from '../../lib/ui/context-menu';

	initContextMenus();
</script>

<style>
	@layer components {
		/* ContextMenu component */
		.context-menu-root,
		.context-menu-trigger {
			display: contents;
		}

		.context-menu-trigger > :global(*) {
			-webkit-touch-callout: none;
		}

		.context-menu-content,
		.context-menu-sub-content {
			z-index: 150;
			min-width: 10rem;
			padding: 0.25rem;
			border: 1px solid var(--app-line);
			border-radius: 0.375rem;
			background: color-mix(in srgb, var(--app-overlay) 95%, transparent);
			box-shadow: 0 10px 24px rgb(0 0 0 / 0.4);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			color: var(--app-muted);
			font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
			font-size: 0.875rem;
			transform-origin: top left;
			animation: context-menu-in 100ms ease-out;
		}

		.context-menu-content {
			position: fixed;
			pointer-events: auto;
		}

		:global(html[data-context-menu-open] body) {
			pointer-events: none;
		}

		.context-menu-content[hidden],
		.context-menu-sub-content[hidden] {
			display: none;
		}

		.context-menu-sub {
			position: relative;
		}

		.context-menu-sub :global(.context-menu-item) {
			width: 100%;
		}

		.context-menu-sub-content {
			position: absolute;
			top: -0.25rem;
			left: calc(100% + 0.375rem);
			min-width: 7rem;
		}

		.context-menu-sub-content[data-side="left"] {
			right: calc(100% + 0.375rem);
			left: auto;
		}

		.context-menu-sub-content[data-align="bottom"] {
			top: auto;
			bottom: -0.25rem;
		}

		.context-menu-group {
			display: flex;
			flex-direction: column;
			gap: 0.125rem;
		}

		.context-menu-heading {
			padding: 0.5625rem 0.5rem 0.4375rem;
			margin: -0.25rem -0.25rem 0.25rem;
			border-bottom: 1px solid var(--app-line-strong);
			border-radius: 0.3125rem 0.3125rem 0 0;
			background: var(--app-fill-subtle);
			color: var(--app-text);
			font-size: 0.875rem;
			font-weight: 600;
			line-height: 1.25;
			text-align: left;
			user-select: none;
		}

		.context-menu-label {
			padding: 0.375rem 0.5rem 0.25rem;
			color: var(--app-faint);
			font-size: 0.75rem;
			line-height: 1;
			text-align: left;
			user-select: none;
		}

		.context-menu-separator {
			height: 1px;
			margin: 0.25rem -0.25rem;
			background: var(--app-line-strong);
		}

		/* Entries are rendered by ContextMenuEntry; keep their styles inside this menu.
		   The zero-specificity root lets radio-item padding override the shared base. */
		:where(.context-menu-root) :global(.context-menu-item) {
			display: flex;
			min-height: 2rem;
			align-items: center;
			gap: 0.5rem;
			padding: 0.375rem 0.5rem;
			border: 0;
			border-radius: 0.25rem;
			background: transparent;
			color: inherit;
			font: inherit;
			text-align: left;
			text-decoration: none;
			white-space: nowrap;
			cursor: default;
			user-select: none;
		}

		:where(.context-menu-root) :global(.context-menu-item:hover),
		:where(.context-menu-root) :global(.context-menu-item:focus),
		:where(.context-menu-root) :global(.context-menu-item[aria-expanded="true"]) {
			outline: none;
			background: var(--app-fill);
			color: var(--app-text);
		}

		:where(.context-menu-root) :global(.context-menu-item-leading) {
			display: inline-flex;
			width: 1.25rem;
			height: 1.25rem;
			flex: none;
			align-items: center;
			justify-content: center;
			line-height: 1;
		}

		:where(.context-menu-root) :global(.context-menu-item-leading > svg) {
			width: 1rem;
			height: 1rem;
		}

		.context-menu-sub :global(.context-menu-sub-chevron) {
			width: 0.875rem;
			height: 0.875rem;
			margin-left: auto;
			flex: none;
		}

		.context-menu-radio-item {
			position: relative;
			padding-left: 2rem;
		}

		.context-menu-radio-indicator {
			position: absolute;
			left: 0.5rem;
			display: inline-flex;
			width: 0.875rem;
			height: 0.875rem;
			align-items: center;
			justify-content: center;
			opacity: 0;
		}

		.context-menu-radio-indicator > :global(svg) {
			width: 0.5rem;
			height: 0.5rem;
			fill: currentColor;
		}

		.context-menu-radio-item[aria-checked="true"] .context-menu-radio-indicator {
			opacity: 1;
		}

		:where(.context-menu-root) :global(.context-menu-item[aria-disabled="true"]),
		:where(.context-menu-root) :global(.context-menu-item:disabled) {
			color: var(--app-faint);
			pointer-events: none;
		}

		@keyframes context-menu-in {
			from {
				opacity: 0;
				transform: scale(0.96);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.context-menu-content,
			.context-menu-sub-content {
				animation: none;
			}
		}
	}
</style>
