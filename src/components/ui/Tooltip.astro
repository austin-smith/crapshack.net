---
interface Props {
	/** Unique id that targets reference via data-tooltip="<id>". */
	id: string;
	/** Positioning within the panel's offset parent, e.g. inset classes. */
	class?: string;
	/** Use a fixed side, or let the scroll container determine placement. */
	placement?: 'auto' | 'above' | 'below';
}
// Targets fill the title/body slots via data-tooltip-title / data-tooltip-body;
// either may be omitted. Slotted children render as-is below them, for panels
// whose content doesn't fit the title/body shape.

const { id, class: className, placement = 'auto' } = Astro.props;
---

<div id={id} class={`tooltip-panel ${className ?? ''}`} role="tooltip" data-tooltip-panel data-tooltip-placement={placement}>
	<span class="tooltip-caret" data-tooltip-caret aria-hidden="true"></span>
	<p class="tooltip-title" data-tooltip-slot="title" hidden></p>
	<p class="tooltip-body" data-tooltip-slot="body" hidden></p>
	<slot />
</div>

<script>
	import { initTooltips } from '../../lib/ui/tooltip';

	initTooltips();
</script>

<style>
	@layer components {
		/* Anchored tooltip (components/ui/Tooltip.astro + lib/ui/tooltip.ts) */
		.tooltip-panel {
			position: absolute;
			z-index: 10;
			pointer-events: none;
			padding: 0.5rem 0.75rem;
			border: 1px solid rgb(var(--app-fill-rgb) / 0.15);
			border-radius: 0.375rem;
			background: var(--app-tooltip);
			box-shadow:
				0 10px 15px -3px rgb(0 0 0 / 0.1),
				0 4px 6px -4px rgb(0 0 0 / 0.1);
			opacity: 0;
			transition: opacity 150ms ease-out;
		}

		.tooltip-panel[data-open='true'] {
			opacity: 1;
		}

		.tooltip-caret {
			position: absolute;
			width: 0.5rem;
			height: 0.5rem;
			background: var(--app-tooltip);
			border: 0 solid rgb(var(--app-fill-rgb) / 0.15);
			transform: rotate(45deg);
			transition: left 150ms ease-out;
		}

		.tooltip-panel[data-placement='below'] .tooltip-caret {
			top: -4.5px;
			border-width: 1px 0 0 1px;
		}

		.tooltip-panel[data-placement='above'] .tooltip-caret {
			bottom: -4.5px;
			border-width: 0 1px 1px 0;
		}

		.tooltip-title {
			font-size: 11px;
			font-weight: 500;
			color: var(--color-brand);
		}

		.tooltip-body {
			margin-top: 0.125rem;
			font-size: 11px;
			line-height: 1.375;
			color: rgb(var(--app-fg-rgb) / 0.75);
		}

		@media (prefers-reduced-motion: reduce) {
			.tooltip-panel,
			.tooltip-caret {
				transition: none;
			}
		}
	}
</style>
