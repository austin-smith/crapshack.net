---
interface Props {
	/** Unique id that targets reference via data-tooltip="<id>". */
	id: string;
	/** Positioning within the panel's offset parent, e.g. inset classes. */
	class?: string;
}

const { id, class: className } = Astro.props;
---

<div id={id} class={`tooltip-panel ${className ?? ''}`} role="tooltip" data-tooltip-panel>
	<span class="tooltip-caret" data-tooltip-caret aria-hidden="true"></span>
	<p class="tooltip-title" data-tooltip-slot="title"></p>
	<p class="tooltip-body" data-tooltip-slot="body"></p>
</div>

<script>
	import { initTooltips } from '../../lib/ui/tooltip';

	initTooltips();
</script>
