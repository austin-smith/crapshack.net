---
import type { HTMLAttributes } from 'astro/types';
import './same-as-it-ever-was-palette.css';

type Props = HTMLAttributes<'div'>;

const { class: className, ...attributes } = Astro.props;
---

{/* The dark board he is chalked on, whatever the site theme. Its parent gives it its size, shape and place. */}
<div {...attributes} class:list={['same-as-it-ever-was-board', className]}>
	<slot />
</div>

<style>
	.same-as-it-ever-was-board {
		background: var(--same-as-it-ever-was-board);
	}
</style>
