---
import { FlaskConical, Gauge, Palette, Smile } from '@lucide/astro';
import { BLONKY_EMOTES } from '../lib/blonky';
import ContextMenu from './ui/ContextMenu.astro';

// Only emotes with a menu icon are offered; the page plays the rest itself.
const emoteItems = Object.entries(BLONKY_EMOTES).flatMap(([value, definition]) => (
	definition.menuIcon
		? [{ icon: definition.menuIcon, label: definition.label, value }]
		: []
));
const styleItems = [
	{ label: 'ink', value: 'ink' },
	{ label: 'clay', value: 'clay' },
];
const speedItems = [
	{ label: '0.25x', value: '0.25' },
	{ label: '0.50x', value: '0.5' },
	{ label: '1.00x', value: '1' },
	{ label: '2.00x', value: '2' },
];
---

<ContextMenu
	id="home-blonky-menu"
	ariaLabel="Blonky actions"
	heading="blonky"
	groups={[
		{
			items: [
				{ icon: Smile, label: 'emotes', items: emoteItems },
				{
					icon: Gauge,
					label: 'speed',
					radioGroup: { name: 'speed', defaultValue: '1', items: speedItems },
				},
				// home-hero owns the style, and falls back to ink where clay
				// can't run.
				{
					icon: Palette,
					label: 'style',
					radioGroup: { name: 'style', value: 'ink', items: styleItems },
				},
			],
		},
		{ items: [{ icon: FlaskConical, label: 'lab', href: '/blonky' }] },
	]}
>
	<slot name="trigger" slot="trigger" />
</ContextMenu>
