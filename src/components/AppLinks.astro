---
import { BookText, Container, Download, ExternalLink, Package } from '@lucide/astro';
import type { AppDefinition } from '../data/apps';
import { buttonVariants } from './ui/button';

interface Props {
	app: AppDefinition;
	size: 'small' | 'regular';
}

const { app, size } = Astro.props;
const buttonSize = size === 'small' ? 'sm' : 'lg';
const primaryLinkClass = buttonVariants({ size: buttonSize });
const secondaryLinkClass = buttonVariants({ variant: 'secondary', size: buttonSize });
---

<div class="scrollbar-none -mr-4 flex gap-2 overflow-x-auto pb-1 pr-4 overscroll-x-contain sm:mr-0 sm:gap-3 sm:pr-0">
	<a
		href={app.repoUrl}
		target="_blank"
		rel="noopener noreferrer"
		class={primaryLinkClass}
	>
		<span aria-hidden="true" data-icon="inline-start" class="icon-github"></span>
		<span>github</span>
	</a>

	{app.releasesUrl && (
		<a href={app.releasesUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<Package data-icon="inline-start" aria-hidden="true" />
			<span>releases</span>
		</a>
	)}

	{app.appStoreUrl && (
		<a href={app.appStoreUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<span aria-hidden="true" data-icon="inline-start" class="icon-apple"></span>
			<span>app store</span>
		</a>
	)}

	{app.appcastUrl && app.releasesUrl && (
		<a href={app.releasesUrl} target="_blank" rel="noopener noreferrer" data-appcast-url={app.appcastUrl} class={secondaryLinkClass}>
			<Download data-icon="inline-start" aria-hidden="true" />
			<span>macOS</span>
		</a>
	)}

	{app.dockerUrl && (
		<a href={app.dockerUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<Container data-icon="inline-start" aria-hidden="true" />
			<span>docker image</span>
		</a>
	)}

	{app.appUrl && (
		<a href={app.appUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<ExternalLink data-icon="inline-start" aria-hidden="true" />
			<span>web app</span>
		</a>
	)}

	{app.docsUrl && (
		<a href={app.docsUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<BookText data-icon="inline-start" aria-hidden="true" />
			<span>docs</span>
		</a>
	)}

	{app.npmUrl && (
		<a href={app.npmUrl} target="_blank" rel="noopener noreferrer" class={secondaryLinkClass}>
			<Package data-icon="inline-start" aria-hidden="true" />
			<span>npm</span>
		</a>
	)}
</div>

<script>
	import { initAppcastLinks } from '../lib/appcast';

	initAppcastLinks();
</script>
