---
import Layout from '../layouts/Layout.astro';
import { spotuify } from '../data/apps';
import AppLinks from '../components/AppLinks.astro';
import ScreenshotGallery from '../components/ui/ScreenshotGallery.astro';
import ToggleGroup from '../components/ui/ToggleGroup.astro';
import {
	AudioLines,
	Check,
	Copy,
	Image,
	MicVocal,
	MonitorSpeaker,
	Search,
	Terminal,
} from '@lucide/astro';

const { repoUrl, icon: iconUrl, description } = spotuify;
const releasesUrl = `${repoUrl}/releases`;
const installMethods = [
	// TODO: uncomment the standalone installer tabs once the install scripts are fully tested
	// {
	// 	value: 'macos-linux',
	// 	tab: 'macOS/Linux',
	// 	caption: 'Standalone installer for Apple Silicon macOS and Linux (x64/arm64).',
	// 	command: 'curl -fsSL https://crapshack.net/spotuify/install.sh | sh',
	// },
	// {
	// 	value: 'windows',
	// 	tab: 'Windows',
	// 	caption: 'Standalone installer for Windows (x64).',
	// 	command: 'irm https://crapshack.net/spotuify/install.ps1 | iex',
	// },
	{
		value: 'npm',
		tab: 'npm',
		caption: 'Global npm install for macOS, Linux, and Windows.',
		command: 'npm install -g spotuify',
	},
	{
		value: 'homebrew',
		tab: 'Homebrew',
		caption: 'Homebrew tap install for macOS and Linux.',
		command: 'brew install austin-smith/tap/spotuify',
	},
];
const screenshots = [
	{
		id: 'now-playing',
		label: 'now playing',
		src: '/images/spotuify/screen-grabs/screen-grab-now-playing.png',
		alt: 'spotuify now playing view with album art filling the terminal',
	},
	{
		id: 'lyrics',
		label: 'lyrics',
		src: '/images/spotuify/screen-grabs/screen-grab-lyrics.png',
		alt: 'spotuify lyrics view with the current line highlighted',
	},
];

const features = [
	{
		title: 'Terminal playback',
		icon: AudioLines,
		body: '320 kbps playback via a built-in Rust librespot engine.',
	},
	{
		title: 'Album art',
		icon: Image,
		body: 'Full-window cover art, super-sampled to the terminal.',
	},
	{
		title: 'Search',
		icon: Search,
		body: 'Track, artist, album, and playlist search with drill-down into every result.',
	},
	{
		title: 'Lyrics',
		icon: MicVocal,
		body: 'Lyrics with a follow-along mode synced to playback.',
	},
	{
		title: 'Spotify Connect',
		icon: MonitorSpeaker,
		body: "Shows up in the Spotify device list, and can control other devices.",
	},
	{
		title: 'Scriptable CLI',
		icon: Terminal,
		body: 'Playback, library, and playlist control with JSON output and shell completions.',
	},
];

---

<Layout
	title={`crapshack (${spotuify.name.toLowerCase()})`}
	ogImage="/open-graph/spotuify.png"
	noIndex={true}
>
	<section class="mx-auto mt-10 max-w-3xl space-y-8">
		<header class="flex items-center gap-4">
			<img src={iconUrl} alt="spotuify icon" width="96" height="96" class="h-24 w-24 shrink-0 object-contain drop-shadow-md" loading="lazy" />
			<div>
				<h1 class="text-3xl font-mono font-semibold bg-gradient-to-r from-[var(--color-brand)] to-[var(--color-text)] bg-clip-text text-transparent">spotuify</h1>
				<p class="text-muted">{description}</p>
			</div>
		</header>

		<AppLinks app={spotuify} size="regular" />

		<ScreenshotGallery
			name="spotuify"
			screenshots={screenshots}
			dialogAriaLabel="spotuify screenshot dialog"
			toggleAriaLabel="Screenshot view"
		/>

		<section class="space-y-3">
			<h2 class="text-2xl font-mono font-semibold text-[var(--color-text)]"># Features</h2>
			<div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
				{features.map((feature) => (
					<article class="rounded-lg border border-line bg-raised p-4 shadow-lg">
						<h3 class="flex items-center gap-2 font-mono font-semibold text-[var(--color-text)]">
							<feature.icon width={18} height={18} stroke-width={2} class="text-[var(--color-brand)]" />
							<span>{feature.title}</span>
						</h3>
						<p class="mt-2 text-sm text-subtle">{feature.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="space-y-3">
			<h2 class="text-2xl font-mono font-semibold text-[var(--color-text)]"># Install</h2>
			<ToggleGroup
				name="spotuify-install-method"
				options={installMethods.map(({ value, tab }) => ({ value, label: tab }))}
				ariaLabel="Install method"
			/>
			<div>
				{installMethods.map(({ value, caption, command }, index) => (
					<div data-install-pane={value} class:list={['space-y-3', { hidden: index !== 0 }]}>
						<p class="text-strong">{caption}</p>
						<div class="space-y-1">
							<p class="font-mono text-sm text-subtle">Install spotuify</p>
							<div class="flex items-center justify-between gap-3 rounded-lg bg-sunken-strong px-4 py-2.5">
								<pre class="overflow-x-auto text-sm"><code class="text-muted">{command}</code></pre>
								<button
									type="button"
									data-copy-command={command}
									class="shrink-0 rounded-md bg-fill p-1.5 text-dim transition-colors hover:bg-fill-strong hover:text-[var(--color-text)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70"
									aria-label={`Copy ${command}`}
								>
									<Copy class="copy-icon" width={16} height={16} stroke-width={2} />
									<Check class="check-icon hidden" width={16} height={16} stroke-width={2} />
								</button>
							</div>
						</div>
						<div class="space-y-1">
							<p class="font-mono text-sm text-subtle">Update spotuify</p>
							<div class="flex items-center justify-between gap-3 rounded-lg bg-sunken-strong px-4 py-2.5">
								<pre class="overflow-x-auto text-sm"><code class="text-muted">spotuify update</code></pre>
								<button
									type="button"
									data-copy-command="spotuify update"
									class="shrink-0 rounded-md bg-fill p-1.5 text-dim transition-colors hover:bg-fill-strong hover:text-[var(--color-text)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70"
									aria-label="Copy spotuify update"
								>
									<Copy class="copy-icon" width={16} height={16} stroke-width={2} />
									<Check class="check-icon hidden" width={16} height={16} stroke-width={2} />
								</button>
							</div>
						</div>
					</div>
				))}
			</div>
			<p class="text-strong">
				Direct downloads for macOS, Linux, and Windows are on{" "}
				<a
					href={releasesUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="underline decoration-[var(--color-brand)] underline-offset-4 hover:text-[var(--color-brand)]"
				>GitHub Releases</a>.
			</p>
		</section>

		<section class="space-y-3">
			<h2 class="text-2xl font-mono font-semibold text-[var(--color-text)]"># First-time Setup</h2>
			<p class="text-strong">Requirements</p>
			<ul class="list-disc pl-6 space-y-1 text-strong">
				<li>
					A <a
						href="https://developer.spotify.com/dashboard"
						target="_blank"
						rel="noopener noreferrer"
						class="underline decoration-[var(--color-brand)] underline-offset-4 hover:text-[var(--color-brand)]"
					>Spotify Developer</a> app (<code class="inline-code">spotuify auth</code> walks through creating one)
				</li>
				<li>
					A <a
						href="https://www.spotify.com/premium/"
						target="_blank"
						rel="noopener noreferrer"
						class="underline decoration-[var(--color-brand)] underline-offset-4 hover:text-[var(--color-brand)]"
					>Spotify Premium</a> subscription (required for playback)
				</li>
			</ul>
			<div class="space-y-1">
				<p class="font-mono text-sm text-subtle">Follow the guided setup</p>
				<div class="flex items-center justify-between gap-3 rounded-lg bg-sunken-strong px-4 py-2.5">
					<pre class="overflow-x-auto text-sm"><code class="text-muted">spotuify auth</code></pre>
					<button
						type="button"
						data-copy-command="spotuify auth"
						class="shrink-0 rounded-md bg-fill p-1.5 text-dim transition-colors hover:bg-fill-strong hover:text-[var(--color-text)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70"
						aria-label="Copy spotuify auth"
					>
						<Copy class="copy-icon" width={16} height={16} stroke-width={2} />
						<Check class="check-icon hidden" width={16} height={16} stroke-width={2} />
					</button>
				</div>
			</div>
		</section>

	</section>
</Layout>

<script>
	import { copyTextToClipboard } from '../lib/clipboard';

	const installPanes = document.querySelectorAll<HTMLElement>('[data-install-pane]');
	const installToggle = document.querySelector('[data-toggle-group="spotuify-install-method"]');

	installToggle?.addEventListener('toggle-change', ((e: CustomEvent<{ value: string }>) => {
		installPanes.forEach((pane) => {
			pane.classList.toggle('hidden', pane.dataset.installPane !== e.detail.value);
		});
	}) as EventListener);

	document.querySelectorAll<HTMLButtonElement>('button[data-copy-command]').forEach((button) => {
		const copyIcon = button.querySelector('.copy-icon');
		const checkIcon = button.querySelector('.check-icon');

		button.addEventListener('click', async () => {
			const success = await copyTextToClipboard(button.dataset.copyCommand ?? '');

			if (success && copyIcon && checkIcon) {
				copyIcon.classList.add('hidden');
				checkIcon.classList.remove('hidden');

				setTimeout(() => {
					copyIcon.classList.remove('hidden');
					checkIcon.classList.add('hidden');
				}, 2000);
			}
		});
	});
</script>
