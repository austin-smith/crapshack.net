---
import BlonkyCanvas from '../components/BlonkyCanvas.astro';
import BlonkyContextMenu from '../components/BlonkyContextMenu.astro';
import Aphorism from '../components/Aphorism.astro';
import Layout from '../layouts/Layout.astro';

const logo = '/images/crapshack.png';
---

<Layout fullBleed>
	<div class="home-hero" data-home-hero-root>
		<div class="home-hero__copy">
			<img src={logo} alt="crapshack" class="home-hero__logo" width="390" />
			<Aphorism />
		</div>

		<BlonkyContextMenu>
			<button
				slot="trigger"
				type="button"
				class="home-hero__character"
				data-home-hero-character
				aria-label="Give Blonky another thought"
			>
				<BlonkyCanvas
					id="home-blonky"
					label="Blonky, a large hand-drawn character leaning into the page"
					view="portrait"
				/>
			</button>
		</BlonkyContextMenu>
	</div>
</Layout>

<script>
	import { registerHomeHeroLifecycle } from '../lib/home-hero';

	registerHomeHeroLifecycle();
</script>

<style>
	.home-hero {
		position: relative;
		min-height: 100dvh;
		overflow: clip;
		text-align: center;
	}

	.home-hero__copy {
		position: absolute;
		z-index: 2;
		top: clamp(6rem, 12svh, 9rem);
		left: 50%;
		width: min(42rem, calc(100% - 2rem));
		transform: translateX(-50%);
	}

	.home-hero__logo {
		display: block;
		width: min(24.375rem, 88vw);
		height: auto;
		margin: 0 auto 0.85rem;
		filter: drop-shadow(0 0.55rem 0.7rem rgb(0 0 0 / 0.16));
	}

	.home-hero__character {
		position: absolute;
		z-index: 1;
		bottom: 0;
		left: 50%;
		/* Account for the portrait canvas's transparent padding as the viewport grows. */
		width: clamp(
			46rem,
			max(92svh, calc(139svh - 34.25rem)),
			114rem
		);
		margin: 0;
		padding: 0;
		transform: translate(-50%, 21%);
		border: 0;
		background: transparent;
		filter: drop-shadow(0 0.8rem 0.9rem rgb(0 0 0 / 0.14));
		cursor: pointer;
		touch-action: manipulation;
	}

	.home-hero__character:focus-visible {
		outline: none;
		filter:
			drop-shadow(0 0.8rem 0.9rem rgb(0 0 0 / 0.14))
			drop-shadow(0 0 0.45rem var(--color-subtle));
	}

	/* Narrow screens reserve enough room for a two-line aphorism. */
	@media (max-width: 620px) {
		.home-hero__logo {
			width: min(22rem, 92vw);
			margin-bottom: 0.65rem;
		}

		.home-hero__copy :global([data-aphorism-root]) {
			min-height: 3.375rem;
		}
	}

	/* Short portrait screens use flow layout so the copy and painted head cannot collide. */
	@media (max-width: 620px) and (max-height: 52rem) {
		.home-hero {
			display: flex;
			height: 100dvh;
			flex-direction: column;
			align-items: center;
		}

		.home-hero__copy {
			position: relative;
			top: auto;
			left: auto;
			flex: none;
			margin-top: clamp(6.5rem, 17svh, 9rem);
			transform: none;
		}

		.home-hero__character {
			position: relative;
			bottom: auto;
			left: auto;
			flex: none;
			width: min(44rem, 170vw);
			margin-top: -1.5rem;
			transform: none;
		}
	}

	/* Keep this last so short landscape wins when desktop zoom also crosses 620px. */
	@media (max-height: 50rem) and (orientation: landscape) {
		.home-hero {
			display: block;
			height: 100dvh;
		}

		.home-hero__copy {
			position: absolute;
			top: clamp(4rem, 12svh, 6rem);
			left: 50%;
			margin-top: 0;
			transform: translateX(-50%);
		}

		.home-hero__logo {
			width: min(24.375rem, 46vw, 62svh);
		}

		.home-hero__copy :global([data-aphorism-root]) {
			min-height: 1.875rem;
		}

		.home-hero__character {
			position: absolute;
			top: clamp(12rem, 38svh, 15.5rem);
			bottom: auto;
			left: 50%;
			width: min(60rem, 110svh, calc(33svh + 30rem));
			margin-top: 0;
			transform: translate(-50%, -7%);
		}
	}
</style>
