---
import { ArrowRight } from '@lucide/astro';
import AppLinks from '../components/AppLinks.astro';
import Layout from '../layouts/Layout.astro';

import { apps } from '../data/apps';

const cardScreenshots: Record<string, { src: string; alt: string }> = {
	BitDream: { src: '/images/bitdream/screen-grabs/screen-grab-light.png', alt: 'BitDream (light mode)' },
	'Computer Solitaire': { src: '/images/computer-solitaire/screen-grabs/screen-grab-macos.png', alt: 'Computer Solitaire on macOS' },
	crapdash: { src: '/images/crapdash/screen-grabs/screen-grab-light.png', alt: 'crapdash (light mode)' },
	PlexBar: { src: '/images/plexbar/screen-grabs/screen-grab-streams.png', alt: 'PlexBar active streams view' },
	spotuify: { src: '/images/spotuify/screen-grabs/screen-grab-lyrics.png', alt: 'spotuify lyrics view' },
	Stuckers: { src: '/images/stuckers/screen-grabs/screengrab-all.png', alt: 'stucker overview' },
	'webhooks.lol': { src: '/images/webhooks-lol/screen-grabs/screen-grab-light.png', alt: 'webhooks.lol (light mode)' },
};

const appCards = apps.map((app) => ({ ...app, screenshot: cardScreenshots[app.name] }));
---

<Layout title="crapshack (apps)">
	<section class="mx-auto mt-10 max-w-5xl space-y-8">
		<header class="apps-header">
			<h1 class="font-mono text-3xl font-semibold bg-gradient-to-r from-[var(--color-brand)] to-[var(--color-text)] bg-clip-text text-transparent">apps</h1>
		</header>

		<div class="grid gap-4 md:grid-cols-2">
			{appCards.map((app) => (
				<article id={app.name.toLowerCase().replaceAll(' ', '-')} class="flex flex-col overflow-hidden rounded-lg border border-line bg-raised shadow-lg scroll-mt-8">
					<a href={app.href} class="block border-b border-line bg-sunken p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70">
						<div class="grid aspect-[16/10] place-items-center overflow-hidden rounded-md bg-fill-subtle">
							<img src={app.screenshot.src} alt={app.screenshot.alt} class="max-h-full max-w-full object-contain drop-shadow-lg" loading="lazy" decoding="async" />
						</div>
					</a>
					<div class="flex flex-1 flex-col gap-4 p-4">
						<div class="flex items-center gap-3">
							<img src={app.icon} alt="" aria-hidden="true" class="h-12 w-12 shrink-0 object-contain drop-shadow-md" loading="lazy" decoding="async" />
							<h2 class="font-mono text-2xl font-semibold text-[var(--color-text)]">
								<a href={app.href} class="group inline-flex items-center gap-2 rounded-sm hover:text-[var(--color-brand)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70">
									<span class="squiggle-underline">{app.name}</span>
									<ArrowRight width={18} height={18} stroke-width={2} aria-hidden="true" class="shrink-0 text-dim transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--color-brand)]" />
								</a>
							</h2>
						</div>
						<p class="text-muted">{app.description}</p>
						<div class="mt-auto">
							<AppLinks app={app} size="small" />
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>
