---
import { BookText, Container, ExternalLink, Package } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';

import { apps } from '../data/apps';

const cardScreenshots: Record<string, { src: string; alt: string }> = {
	BitDream: { src: '/images/bitdream/screen-grabs/screen-grab-light.png', alt: 'BitDream (light mode)' },
	'Computer Solitaire': { src: '/images/computer-solitaire/screen-grabs/screen-grab-macos.png', alt: 'Computer Solitaire on macOS' },
	crapdash: { src: '/images/crapdash/screen-grabs/screen-grab-light.png', alt: 'crapdash (light mode)' },
	PlexBar: { src: '/images/plexbar/screen-grabs/screen-grab-streams.png', alt: 'PlexBar active streams view' },
	Stuckers: { src: '/images/stuckers/screen-grabs/screengrab-all.png', alt: 'stucker overview' },
	'webhooks.lol': { src: '/images/webhooks-lol/screen-grabs/screen-grab-light.png', alt: 'webhooks.lol (light mode)' },
};

const appCards = apps.map((app) => ({
	...app,
	screenshot: cardScreenshots[app.name].src,
	screenshotAlt: cardScreenshots[app.name].alt,
	links: [
		{ label: 'github', href: app.repoUrl, kind: 'github' },
		{ label: 'releases', href: `${app.repoUrl}/releases` },
		app.appcastUrl
			? { label: 'macOS', href: `${app.repoUrl}/releases`, kind: 'apple', appcastUrl: app.appcastUrl }
			: app.directDownloadUrl && { label: 'macOS', href: app.directDownloadUrl, kind: 'apple' },
		app.dockerUrl && { label: 'docker image', href: app.dockerUrl, kind: 'container' },
		app.appStoreUrl && { label: 'app store', href: app.appStoreUrl, kind: 'apple' },
		app.appUrl && { label: 'web app', href: app.appUrl, kind: 'external' },
		app.docsUrl && { label: 'docs', href: app.docsUrl, kind: 'docs' },
		app.npmUrl && { label: 'npm', href: app.npmUrl },
	].filter(Boolean),
}));
---

<Layout title="crapshack (apps)">
	<section class="mx-auto mt-10 max-w-5xl space-y-8">
		<header class="apps-header">
			<h1 class="font-mono text-3xl font-semibold bg-gradient-to-r from-[var(--color-brand)] to-white bg-clip-text text-transparent">apps</h1>
		</header>

		<div class="grid gap-4 md:grid-cols-2">
			{appCards.map((app) => (
				<article id={app.name.toLowerCase().replaceAll(' ', '-')} class="flex flex-col overflow-hidden rounded-lg border border-white/10 bg-white/[0.04] shadow-lg scroll-mt-8">
					<a href={app.href} class="block border-b border-white/10 bg-black/20 p-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70">
						<div class="grid aspect-[16/10] place-items-center overflow-hidden rounded-md bg-white/5">
							<img src={app.screenshot} alt={app.screenshotAlt} class="max-h-full max-w-full object-contain drop-shadow-lg" loading="lazy" decoding="async" />
						</div>
					</a>
					<div class="flex flex-1 flex-col gap-4 p-4">
						<div class="flex items-center gap-3">
							<img src={app.icon} alt="" aria-hidden="true" class="h-12 w-12 shrink-0 object-contain drop-shadow-md" loading="lazy" decoding="async" />
							<h2 class="font-mono text-2xl font-semibold text-[var(--color-text)]">
								<a href={app.href} class="hover:text-[var(--color-brand)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70 rounded-sm">
									{app.name}
								</a>
							</h2>
						</div>
						<p class="text-white/90">{app.description}</p>
						<div class="mt-auto flex flex-wrap gap-2">
							<a href={app.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-md bg-[var(--color-brand)] px-3 py-1.5 text-sm font-medium text-black hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70">
								<ExternalLink width={15} height={15} stroke-width={2} class="mr-2" />
								<span>page</span>
							</a>
							{app.links.map((link) => (
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center rounded-md border border-white/20 px-3 py-1.5 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-brand)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]/70"
									data-appcast-url={link.appcastUrl}
								>
									{link.kind === 'github' ? (
										<span aria-hidden="true" class="mr-2 h-4 w-4 shrink-0 icon-github"></span>
									) : link.kind === 'apple' ? (
										<span aria-hidden="true" class="mr-2 h-4 w-4 shrink-0 icon-apple"></span>
									) : link.kind === 'external' ? (
										<ExternalLink width={15} height={15} stroke-width={2} class="mr-2" />
									) : link.kind === 'docs' ? (
										<BookText width={15} height={15} stroke-width={2} class="mr-2" />
									) : link.kind === 'container' ? (
										<Container width={15} height={15} stroke-width={2} class="mr-2" />
									) : (
										<Package width={15} height={15} stroke-width={2} class="mr-2" />
									)}
									<span>{link.label}</span>
								</a>
							))}
						</div>
					</div>
				</article>
			))}
		</div>
	</section>
</Layout>

<script>
	import { initAppcastLinks } from '../lib/appcast';

	initAppcastLinks();
</script>
