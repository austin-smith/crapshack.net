---
import Layout from '../layouts/Layout.astro';
import Physics404 from '../components/Physics404.astro';
---

<Layout
	title="crapshack (404)"
	noIndex
	fullBleed
>
	<Physics404 />

	<script>
		import { initPhysics404 } from '../lib/physics-404.ts';
		import { typedText } from '../lib/ui/typed-text.ts';

		const root = document.querySelector<HTMLElement>('[data-physics-404]');
		const el = document.querySelector<HTMLElement>('[data-typed-text]');
		if (root) void initPhysics404(root);
		if (el) {
			void typedText(el, 'this must not be the place', {
				preTypeDelayMs: 700,
				keepCursorMs: 1800,
			});
		}
	</script>
</Layout>
